# Copia este archivo a .env.local y llena los valores.
DATABASE_URL=postgres://USUARIO@localhost:5432/planner3d
# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cuenta de prueba solo para desarrollo local (no es una cuenta real).
DEV_TEST_EMAIL=prueba@planner3d.test
DEV_TEST_PASSWORD=prueba-6c00f2f2

# Códigos de invitación para crear cuenta (sin ninguno, cualquiera se registra con acceso completo: solo en desarrollo).
# SIGNUP_CODE: un código con acceso completo y sin vencimiento.
# SIGNUP_CODES: JSON con un código por cliente o campaña; kind = planner | venue | agency | developer,
# plan = prueba | eventos | casas | ambos, modules (solo en prueba) = ["salones"] o ["casas"], days (solo en prueba).
# SIGNUP_CODE=
# SIGNUP_CODES={"PLANNER7":{"kind":"planner","plan":"prueba","modules":["salones"],"days":7},"VDEVACA":{"kind":"venue","plan":"eventos"}}

# Administración de ProLink (/admin): correos con acceso, separados por coma.
# ADMIN_EMAILS=carlos@prolink365.com.mx
# WhatsApp de ProLink para los avisos de la demo y del catálogo (solo dígitos con lada de país).
# CONTACT_WHATSAPP=526681305828
# Datos para pagar por transferencia (se muestran en Mi negocio → Tu plan). Sin ellos, la app pide los datos por WhatsApp.
# Son valores de ejemplo: poner el banco, la CLABE de 18 dígitos y el titular reales en las variables de Railway.
# SPEI_BANK=Nombre del banco
# SPEI_CLABE=CLABE de 18 digitos
# SPEI_HOLDER=Nombre del titular de la cuenta

# Respaldos diarios fuera de Railway (backup/respaldo.sh; ver docs/respaldos.md). Sin S3_BUCKET se guardan en ./respaldos.
# S3_BUCKET=plantea-respaldos
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PREFIX=plantea
# BACKUP_KEEP_DAYS=30

# Correo transaccional (olvidé mi contraseña). Sin RESEND_API_KEY, en desarrollo el correo se imprime en la consola.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Plantea <hola@plantea.com.mx>
# Buzón real para las respuestas (con Email Routing de Cloudflare, hola@plantea.com.mx puede llegar a tu correo).
# EMAIL_REPLY_TO=hola@plantea.com.mx

# Errores a Sentry (servidor y navegador). Sin SENTRY_DSN no se manda nada. Ver docs/alertas.md.
# SENTRY_DSN=https://<clave>@o<org>.ingest.us.sentry.io/<proyecto>

# Límite de intentos de inicio de sesión (Better Auth): activo en producción; AUTH_RATE_LIMIT=1 lo prende en local.
# AUTH_RATE_LIMIT=1

# Datos para verificar a Plantea en /nosotros y en los datos para Google (opcionales; sin ellos no se muestran).
# PLANTEA_RFC=
# PLANTEA_INSTAGRAM=https://www.instagram.com/...
# PLANTEA_FACEBOOK=https://www.facebook.com/...
# PLANTEA_GOOGLE_PROFILE=https://maps.app.goo.gl/...
